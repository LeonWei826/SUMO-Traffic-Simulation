<?xml version="1.0" encoding="UTF-8"?>
<additional>
    <!-- ========================================== -->
    <!--        Pre-Warning Detectors (Approaching) -->
    <!-- ========================================== -->
    
    <!-- North to South (N2S) Detector -->
    <e1Detector id="0" lane="4i_0" pos="400" freq="30" file="cross.out" friendlyPos="x"/>
    
    <!-- South to North (S2N) Detector -->
    <e1Detector id="1" lane="3i_0" pos="400" freq="30" file="cross.out" friendlyPos="x"/>
    
    <!-- West to East (W2E) Detector -->
    <e1Detector id="2" lane="1i_0" pos="400" freq="30" file="cross.out" friendlyPos="x"/>
    
    <!-- East to West (E2W) Detector -->
    <e1Detector id="3" lane="2i_0" pos="400" freq="30" file="cross.out" friendlyPos="x"/>


    <!-- ========================================== -->
    <!--         Post-Clearance Detectors (Exiting) -->
    <!-- ========================================== -->
    
    <!-- North to South (N2S) Detector -->
    <e1Detector id="4" lane="3o_0" pos="5" freq="30" file="cross.out" friendlyPos="x"/>
    
    <!-- South to North (S2N) Detector -->
    <e1Detector id="5" lane="4o_0" pos="5" freq="30" file="cross.out" friendlyPos="x"/>
    
    <!-- West to East (W2E) Detector -->
    <e1Detector id="6" lane="2o_0" pos="5" freq="30" file="cross.out" friendlyPos="x"/>
    
    <!-- East to West (E2W) Detector -->
    <e1Detector id="7" lane="1o_0" pos="5" freq="30" file="cross.out" friendlyPos="x"/>
</additional>